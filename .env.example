# Virlo API — https://virlo.ai/developers
VIRLO_API_KEY=

# Gemini API (for Imagen image generation)
GEMINI_API_KEY=

# Blotato API (for TikTok drafts + visual creation)
BLOTATO_API_KEY=

# ScrapeCreators API (per-post TikTok metrics)
SCRAPECREATORS_API_KEY=
FIRECRAWL_API_KEY=
# Server-only. Required by the private Creddy ingestion worker; never expose it
# in browser code or copy it into the Creddy app repository.
SUPABASE_SERVICE_ROLE_KEY=
CREDDY_SUPABASE_URL=
CREDDY_SUPABASE_ANON_KEY=
AI_PROVIDER=openai
# Creddy uses Codex Scheduled Tasks by default. OPENAI_API_KEY is needed only
# if CREDDY_AI_EXECUTION_MODE is intentionally changed to openai_api.
CREDDY_AI_EXECUTION_MODE=codex_scheduled
OPENAI_API_KEY=
CREDDY_PIPELINE_ENABLED=false
CREDDY_CAMPAIGN_SLUG=credit-card-rewards
CREDDY_DATA_ROOT="/Users/your-user/Documents/ChatGPT/Social media automation data"
CREDDY_MAX_LINKS_PER_SOURCE=10
CREDDY_MAX_ARTICLE_SCRAPES=40
CREDDY_RECHECK_HOURS=24
VIDEO_FACTORY_BASE_URL=http://127.0.0.1:4300
CREDDY_BACKGROUND_MUSIC_PATH=
CREDDY_PUBLISH_LEAD_MINUTES=15
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL_ID=
# Creddy lifecycle updates. Agent 7 rich review messages require a bot with
# chat:write + files:write; the bot must be invited to this channel.
SLACK_SOCIAL_UPDATES_WEBHOOK_URL=
SLACK_SOCIAL_UPDATES_CHANNEL_ID=
DASHBOARD_BASE_URL=https://your-public-dashboard.example.com
